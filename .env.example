# ========================
# BACKEND ENVIRONMENT VARIABLES
# ========================

# Node environment (development or production)
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# For local MongoDB:
#   MONGODB_URI=mongodb://localhost:27017/digital-forensics
# For MongoDB Atlas (cloud):
#   MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digital-forensics?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/digital-forensics

# Frontend URL for CORS (required in production)
# Development: http://localhost:5173
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Request size limit (default: 10mb)
REQUEST_LIMIT=10mb

# ========================
# FRONTEND ENVIRONMENT VARIABLES
# ========================

# API URL for production builds
# Development: Uses Vite proxy, can be empty or /api
# Production: Set to backend API URL (e.g., https://api.yourdomain.com)
# Build-time variable for Vite: npm run build builds with this value
VITE_API_URL=/api

# ========================
# RENDER DEPLOYMENT VARIABLES
# ========================
# When deploying to Render:
# - Set NODE_ENV=production
# - Set PORT=PORT (Render assigns dynamically, but 5000 is default)
# - Set MONGODB_URI=<your MongoDB Atlas connection string>
# - Set CLIENT_URL=<your frontend Render URL>
# - Set VITE_API_URL=<your backend Render URL> (frontend build)

# ========================
# NOTES FOR PRODUCTION
# ========================
# 1. Never commit .env file - only .env.example
# 2. Ensure all variables are set in your deployment platform
# 3. Use strong passwords for MongoDB Atlas user
# 4. Use HTTPS URLs in production (CLIENT_URL, VITE_API_URL)
# 5. CORS will reject requests from mismatched origins in production
# 6. Health check: GET /api/health (no auth required)

